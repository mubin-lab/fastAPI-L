# Copy to .env and edit. Never commit .env.
APP_NAME="Tasks API"
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=sqlite+aiosqlite:///./app.db
# Postgres example: postgresql+asyncpg://user:pass@localhost:5432/appdb  (uv add asyncpg)

# REQUIRED in real deployments, MUST be at least 32 characters (app refuses to start otherwise).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-32+chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# JSON list of explicit origins (wildcard is rejected because credentials are allowed)
CORS_ORIGINS=["http://localhost:3000"]

# Optional: bootstrap an admin account at startup (created only if the e-mail does not exist)
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=ChangeMe-Str0ngPassword
